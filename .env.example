# ==============================================================================
# UNIFIED INTELLIGENT CUSTOMER SUPPORT AI PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions: Copy this file to '.env' for local development.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# --- APPLICATION & ENVIRONMENT ---
ENVIRONMENT=development                # 'development', 'staging', 'production'
DEBUG=true                             # MUST be false in production
LOG_LEVEL=INFO                         # 'DEBUG', 'INFO', 'WARNING', 'ERROR'
APP_NAME="Intelligent Customer Support AI Platform"
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
ENABLE_DEV_AUTH_ENDPOINTS=false        # MUST be false in production; set true ONLY for local dev persona testing

# --- SECURITY & AUTHENTICATION (JWT & ENCRYPTION) ---
# Generate a cryptographically secure key: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secure_random_hex_key_in_production
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32-byte hex key for AES-256-GCM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- POSTGRESQL DATABASE ---
POSTGRES_USER=support_admin
POSTGRES_PASSWORD=support_password_placeholder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_support_db
# Async Database URL for SQLAlchemy 2.0
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- REDIS & ASYNCHRONOUS BACKGROUND WORKERS ---
# Note: Asynchronous tasks run via native PostgreSQL-backed AsyncIO workers
# (EscalationWorker, ReconciliationWorker, EvidenceRetentionWorker) using SELECT FOR UPDATE SKIP LOCKED.
# Set ENABLE_BACKGROUND_WORKERS=true for monolithic local dev; in docker-compose, backend API is set to false and worker is set to true.
ENABLE_BACKGROUND_WORKERS=true
REDIS_REQUIRED=false                    # Set true in staging/production where Redis is mandatory for /health/ready

# --- HTTP REQUEST RATE LIMITING ---
RATE_LIMIT_ENABLED=true                 # Application-level request rate limiting (strictly mandatory in staging/production)
RATE_LIMIT_CHAT_PER_MINUTE=30           # 30 chat turn queries per minute per client
RATE_LIMIT_EVIDENCE_PER_MINUTE=10       # 10 multimodal uploads per minute per client
TRUSTED_PROXIES=["127.0.0.1", "::1", "172.28.0.10"]    # Authorized reverse proxy IPs/CIDRs for real client IP extraction
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=50
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_PUBSUB_INDEX_RELOAD_CHANNEL=channel:knowledge:index_reload

# --- AI PROVIDERS & LLM GATEWAY ---
# Primary Cloud Inference: Google Gemini API
# Get an API key from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GOOGLE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
PRIMARY_LLM_PROVIDER=gemini              # Supported aliases: PRIMARY_LLM_PROVIDER, LLM_PRIMARY_PROVIDER ('gemini', 'ollama')
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3                       # Supported aliases: LLM_MAX_RETRIES, LLM_RETRY_LIMIT

# Fallback Local Inference: Ollama (LLaMA 3)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
ENABLE_OLLAMA_FALLBACK=true             # Supported aliases: ENABLE_OLLAMA_FALLBACK, LLM_ENABLE_FALLBACK
LLM_FALLBACK_PROVIDER=ollama            # Supported aliases: LLM_FALLBACK_PROVIDER, FALLBACK_LLM_PROVIDER ('ollama', 'none')

# Local Embeddings: HuggingFace Sentence Transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- VECTOR SEARCH (FAISS) & KNOWLEDGE STORAGE ---
FAISS_STORAGE_DIR=./storage/indices
KNOWLEDGE_DOCS_DIR=./storage/raw_documents
QUARANTINE_DIR=./storage/quarantine
SIMILARITY_THRESHOLD=0.72              # Minimum confidence threshold for RAG retrieval
BENCHMARK_GROUNDING_PASS_SCORE=0.90    # 90% grounding required for index activation
REDIS_PUBSUB_INDEX_RELOAD_CHANNEL=channel:knowledge:index_reload
MAINTENANCE_WINDOW_CRON="0 2 * * 0"     # Sundays at 02:00 UTC for index promotion
WATCHDOG_MONITOR_SECONDS=300           # 5-minute canary evaluation window

# --- MULTIMODAL & EVIDENCE STORAGE ---
EVIDENCE_STORAGE_DIR=./storage/evidence_uploads
EVIDENCE_STAGING_DIR=./storage/evidence_uploads/staged
MAX_FILE_SIZE_BYTES=20971520           # 20 MB max file size limit
ALLOWED_MIME_TYPES=["image/jpeg", "image/png", "image/webp", "application/pdf"]
FILE_RETENTION_DAYS=30                 # Storage TTL before automated purge
FAST_PATH_OCR_TIMEOUT_SECONDS=3        # Return 202 Accepted if processing exceeds 3s

# --- SUPPORT TICKETING & SLA POLICIES ---
DEFAULT_SLA_TARGET_MINUTES=240         # 4-hour default resolution SLA
SLA_WARNING_THRESHOLD_PERCENT=75       # Trigger warning at 75% elapsed SLA
SLA_PENDING_CUSTOMER_PAUSE=true        # Pause countdown while ticket is PENDING_CUSTOMER
UNRESOLVED_NEGATIVE_TIMEOUT_MINUTES=15 # Auto-escalate negative chats after 15 mins
BUSINESS_HOURS_TIMEZONE=America/New_York
BUSINESS_HOUR_START=09:00:00
BUSINESS_HOUR_END=17:00:00

# --- MULTILINGUAL CONFIGURATION ---
PRIMARY_LANGUAGE=en
SUPPORTED_LANGUAGES=["en", "es", "fr", "de"]
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_RESTORATION_WINDOW_HOURS=24
